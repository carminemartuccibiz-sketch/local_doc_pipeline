    # Client registrato PRIMA della chiamata
    client = httpx.Client(timeout=LM_TIMEOUT_S, headers=_auth_headers())
    state.register_client(client)
    try:
        r = client.post(url, json=payload)
        r.raise_for_status()
        return r.json()["choices"][0]["message"]["content"].strip()
    except httpx.HTTPError as e:
        if state.stop_event.is_set():
            raise InterruptedError("Richiesta annullata da Kill Switch") from e
        raise
    finally:
        state.unregister_client(client)
        client.close()
