## Task 3 — Kill Switch: Logica e Snippet

Il problema che hai descritto è reale: LM Studio accoda le richieste HTTP lato server. `Ctrl+C` interrompe il Python ma la richiesta è già in volo. La soluzione è un **abort a tre livelli**.

```python
# engine/orchestrator.py

import threading
import httpx
from queue import Queue, Empty
from dataclasses import dataclass, field
from typing import Callable
import logging

logger = logging.getLogger(__name__)


@dataclass
class OrchestratorState:
    stop_event: threading.Event = field(default_factory=threading.Event)
    active_requests: list[httpx.Client] = field(default_factory=list)
    _lock: threading.Lock = field(default_factory=threading.Lock)

    def register_client(self, client: httpx.Client) -> None:
        with self._lock:
            self.active_requests.append(client)

    def unregister_client(self, client: httpx.Client) -> None:
        with self._lock:
            try:
                self.active_requests.remove(client)
            except ValueError:
                pass

    def kill_all(self) -> None:
        """
        Livello 1: segnala stop a tutti i thread worker.
        Livello 2: chiude i client httpx attivi (annulla richieste in volo).
        Livello 3: svuota la job queue.
        """
        logger.warning("KILL SWITCH attivato")
        self.stop_event.set()

        # Livello 2: forza chiusura connessioni HTTP aperte
        with self._lock:
            for client in list(self.active_requests):
                try:
                    client.close()
                    logger.info("Client HTTP chiuso: %s", id(client))
                except Exception:
                    pass
            self.active_requests.clear()


# Singleton globale condiviso con la UI
_state = OrchestratorState()


def get_orchestrator_state() -> OrchestratorState:
    return _state


def reset_orchestrator() -> None:
    global _state
    _state = OrchestratorState()
```

