from flask import Flask, jsonify
from engine.orchestrator import get_orchestrator_state, reset_orchestrator

app = Flask(__name__)

@app.post("/api/stop")
def api_stop():
    """Chiamato dal pulsante STOP nella UI."""
    get_orchestrator_state().kill_all()
    return jsonify({"status": "stopped", "message": "Pipeline fermata."})

@app.post("/api/reset")
def api_reset():
    """Reset per avviare un nuovo job dopo lo stop."""
    reset_orchestrator()
    return jsonify({"status": "ready"})
