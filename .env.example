# Copia in .env nella stessa cartella

# === Profilo i9 + 2080 Ti — ECO (basso carico, consigliato se non hai fretta) ===
PIPELINE_HARDWARE_PROFILE=i9-2080ti-eco
PIPELINE_MAX_CONCURRENCY=1
PIPELINE_LM_COOLDOWN_S=6
PIPELINE_CHUNK_COOLDOWN_S=4
PIPELINE_FILE_PAUSE_S=12

# === Repo documentazione (sorella) ===
DVAMOCLES_SOURCE_ROOT=E:\DVAMOCLES-SWORD-AMBIENT-FULL-DOCUMENTATION

# === LM Studio ===
LM_STUDIO_BASE_URL=http://localhost:1234/v1
# LM Studio → Developer → Server → API key (opzionale se il server non richiede auth)
LM_STUDIO_API_KEY=your-lm-studio-api-key-here
LM_USE_NATIVE_CHAT=true
LM_STUDIO_MODEL=auto
LM_TIMEOUT_S=600
LM_NATIVE_CONTEXT=12288

# === AnythingLLM ===
ANYTHINGLLM_BASE_URL=http://localhost:3001
ANYTHINGLLM_API_KEY=your-anythingllm-api-key-here
ALLM_SOT_WORKSPACE_NAME=Dvamocles_SOT_Canon
ALLM_SOT_WORKSPACE_SLUG=dvamocles_sot_canon

ALLM_WORKSPACE_NAME=Dvamocles_Raw_Docs
ALLM_WORKSPACE_SLUG=dvamocles-raw-docs

# Embedding LAST DOCS nel workspace SOT
# manual = Salva e incorpora dall'UI AnythingLLM (no API update-embeddings)
# per_file = API embed dopo ogni upload | batch = tutti insieme (può timeout)
ALLM_EMBED_MODE=manual
ALLM_EMBED_TIMEOUT_S=900
ALLM_EMBED_RETRIES=1

# === Gap analysis (modello ~8k context) ===
# false = tier 1 LAST DOCS + tier 2 Documentazione vecchia
GAP_SOT_LAST_DOCS_ONLY=false
GAP_BATCH_SIZE=1
GAP_RAW_INPUT_TOKEN_BUDGET=2800
GAP_MODEL_CONTEXT_TOKENS=12288
GAP_MAX_SOT_CHARS=2800
GAP_MAX_RAW_CHARS=11000
GAP_MAX_REPORT_CHARS=2800
GAP_USE_ALLM_RAG=true
GAP_RAG_TOP_N=3
GAP_RAG_MAX_CHARS=2000
GAP_CHUNK_MAX_TOKENS=900
GAP_CHUNK_MIN_SECTION_TOKENS=180
UPLOAD_BATCH_PAUSE_S=3
GAP_LM_MAX_OUTPUT=1536
GAP_LM_MAX_OUTPUT_CONSOLIDATE=2400
GAP_REPORT_CONSOLIDATE=true
GAP_PER_FILE_REPORTS=false
GAP_MAX_REPORT_CHARS=12000
GAP_MAX_SOT_CHARS_WITH_RAG=600
GAP_RAG_TOP_N=5
GAP_RAG_MAX_CHARS=2800
GAP_STATE_KEEP_COMPLETED=200

# === Modello ~16k (decommentare e adattare) ===
# GAP_RAW_INPUT_TOKEN_BUDGET=8000
# GAP_MODEL_CONTEXT_TOKENS=16384
# GAP_MAX_SOT_CHARS=6000
# GAP_RAG_TOP_N=10
# GAP_LM_MAX_OUTPUT=2500
