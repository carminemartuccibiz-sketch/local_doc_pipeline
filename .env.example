# Copia in .env nella stessa cartella o esporta in PowerShell

# Radice repo documentazione
DVAMOCLES_SOURCE_ROOT=E:\DVAMOCLES-SWORD-AMBIENT-FULL-DOCUMENTATION

# AnythingLLM — Settings → API Keys → Generate
ANYTHINGLLM_BASE_URL=http://localhost:3001
ANYTHINGLLM_API_KEY=your-anythingllm-api-key-here

# Workspace pipeline ingest (slug usato nelle API)
ALLM_WORKSPACE_NAME=Dvamocles_Raw_Docs
ALLM_WORKSPACE_SLUG=dvamocles-raw-docs

# Workspace Gap Analysis — indicizzazione SOT + RAG
ALLM_SOT_WORKSPACE_NAME=Dvamocles_SOT_Canon
ALLM_SOT_WORKSPACE_SLUG=dvamocles-sot-canon

# LM Studio — Developer → Start Server (porta 1234)
LM_STUDIO_BASE_URL=http://localhost:1234/v1
# auto = discovery runtime GET /v1/models; oppure nome modello fisso
LM_STUDIO_MODEL=auto
# LM_STUDIO_MODEL_FALLBACK=local-model
# Modelli VL (qwen-vl): usa API nativa per evitare HTTP 400 su /v1/chat/completions
LM_USE_NATIVE_CHAT=true

# Installazioni locali (solo riferimento)
# LM_STUDIO_INSTALL_DIR=C:\Users\Carmine\AppData\Local\Programs\LM Studio
# ANYTHINGLLM_INSTALL_DIR=C:\Users\Carmine\AppData\Local\Programs\AnythingLLM
# ANYTHINGLLM_API_V1_URL=http://localhost:3001/api/v1
# LM_STUDIO_API_KEY=lm-studio
# LM_USE_NATIVE_CHAT=true

# Limiti pipeline
# PIPELINE_MAX_CHARS=24000
# PIPELINE_RAG_TOP_N=12
# LM_TIMEOUT_S=300

# Gap analysis (cli.py ai-gap-analysis)
# AI_BACKEND=lm_studio
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2
# GAP_MAX_SOT_CHARS=14000
# GAP_MAX_RAW_CHARS=9000
# GAP_MAX_REPORT_CHARS=6000
# GAP_USE_ALLM_RAG=true
# GAP_RAG_TOP_N=10
